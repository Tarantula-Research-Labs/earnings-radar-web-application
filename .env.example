# Copy to .env.local for running on your computer. In Vercel, add these under
# Project -> Settings -> Environment Variables. Never commit real values.

# Read-only key of the IAM user "earnings-radar-reader"
RADAR_AWS_ACCESS_KEY_ID=
RADAR_AWS_SECRET_ACCESS_KEY=
RADAR_AWS_REGION=ap-south-1

# Where the radar data lives
RADAR_BUCKET=trl-earnings-radar
RADAR_PREFIX=earnings-radar
